
# Docker SQL Server connection
PHISHGUARD_SQL_SERVER=host.docker.internal,1433
PHISHGUARD_SQL_DATABASE=PhishGuardDB
PHISHGUARD_SQL_AUTH=sql

# Replace these with your dedicated SQL Server application login.
PHISHGUARD_SQL_USER=phishguard_app
PHISHGUARD_SQL_PASSWORD=CHANGE_THIS_PASSWORD

# Generate a random secret; never publish it.
PHISHGUARD_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# false for localhost HTTP development; true behind HTTPS.
PHISHGUARD_COOKIE_SECURE=false
